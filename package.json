{
  "name": "bashreactor",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.13",
  "workspaces": ["packages/*", "apps/*"],
  "scripts": {
    "build": "bun build apps/web/src/server.ts --target=bun --outfile=dist/server.js",
    "check": "bun run lint && bun run typecheck && bun run test",
    "lint": "oxlint --deny-warnings",
    "serve": "bun apps/api/src/main.ts",
    "test": "bun test",
    "typecheck": "bun run --filter './packages/*' --filter './apps/*' typecheck"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "oxlint": "1.91.0",
    "puppeteer-core": "24",
    "typescript": "7.0.2"
  }
}
